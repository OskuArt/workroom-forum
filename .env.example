# Core
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SITE_NAME=WORK//ROOM
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workroom
DATABASE_SSL=false

# First admin account. Register this email normally and verify it.
ADMIN_EMAIL=you@example.com

# SMTP. If left blank in development, verification code + link are printed to the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WORK//ROOM <no-reply@example.com>"

# External vacancy feed
ENABLE_JOB_IMPORT=true
JOB_IMPORT_INTERVAL_HOURS=6

# Number of Arbeitnow pages to scan per import (1-8). Used to add office/hybrid roles.
ARBEITNOW_IMPORT_PAGES=4
