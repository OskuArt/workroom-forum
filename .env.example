# Core
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
SITE_NAME=WORK//ROOM
SESSION_SECRET=replace-with-a-long-random-secret

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workroom
DATABASE_SSL=false

# First admin account. Register this email normally and verify it.
ADMIN_EMAIL=you@example.com

# Email delivery. Production currently uses Brevo through brevo-fetch-shim.js.
BREVO_API_KEY=
BREVO_FROM_EMAIL=

# Optional SMTP fallback for local development.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="WORK//ROOM <no-reply@example.com>"

# Legacy Jobicy / Arbeitnow importer in server.js. Keep disabled when using the
# unified vacancy monitor below.
ENABLE_JOB_IMPORT=false

# Unified vacancy monitor: hh.ru + Telegram + Instagram.
VACANCY_MONITOR_ENABLED=true
VACANCY_MAX_AGE_DAYS=21
HH_PERIOD_DAYS=3
HH_QUERY_LIMIT=60
HH_DETAIL_LIMIT=260

# Public Telegram channels, comma-separated.
TELEGRAM_JOB_CHANNELS=mirkreatorovjob,designhunters,jun_hi_vacancies,serbia_vacancies,rabotavserbii,desivr_design

# Instagram partner accounts + multilingual hashtag discovery.
INSTAGRAM_JOB_ACCOUNTS=vacancy_design,simple_studio,beginit.indrive.ca
INSTAGRAM_HASHTAG_BUDGET=4
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
