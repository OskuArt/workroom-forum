<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between align-start"><div><div class="eyebrow">longform</div><h1 class="h1">Статьи</h1><p class="lead">Длинные тексты, разборы, исследования и опыт. Для мыслей, которым тесно в одном посте.</p></div><% if(user){ %><a class="pill black" href="/articles/new">+ Написать статью</a><% } %></div>
<div class="grid three"><% if(articles.length){ articles.forEach(a=>{ %><a class="card hover" href="/articles/<%= a.id %>"><% if(a.cover_media_id){ %><img class="post-image" src="/media/<%= a.cover_media_id %>" alt=""><% } %><div class="eyebrow"><%= new Date(a.published_at||a.created_at).toLocaleDateString('ru-RU') %></div><h2 class="h2"><%= a.title %></h2><p><%= a.excerpt || a.body.slice(0,190) %></p><div class="post-head"><% if(a.avatar_media_id){ %><img class="avatar sm" src="/media/<%= a.avatar_media_id %>" alt=""><% } else { %><div class="avatar sm placeholder">@</div><% } %><div><strong><%= a.name || `@${a.username}` %></strong><div class="muted">@<%= a.username %></div></div></div></a><% }) } else { %><div class="empty">Статей пока нет. Возможно, первая будет вашей.</div><% } %></div></main>
<%- include('../partials/footer') %>
