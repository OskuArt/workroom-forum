<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><article class="cv-sheet"><div class="eyebrow">article / <%= article.status %></div><h1 class="display medium"><%= article.title %></h1><p class="lead"><%= article.excerpt || '' %></p><a class="post-head" href="/u/<%= article.username %>"><% if(article.avatar_media_id){ %><img class="avatar sm" src="/media/<%= article.avatar_media_id %>" alt=""><% } else { %><div class="avatar sm placeholder">@</div><% } %><div><strong><%= article.name || `@${article.username}` %></strong><div class="muted">@<%= article.username %> · <%= article.profession || '' %></div></div></a><% if(article.cover_media_id){ %><img class="post-image" style="margin:28px 0" src="/media/<%= article.cover_media_id %>" alt="Обложка статьи"><% } %><div class="cv-block preline" style="font-size:1.12rem;line-height:1.6"><%= article.body %></div><div class="cv-block row between"><span class="muted"><%= new Date(article.published_at||article.created_at).toLocaleString('ru-RU') %></span><% if(owner){ %><a class="pill black" href="/articles/<%= article.id %>/edit">Редактировать</a><% } %></div></article></main>
<%- include('../partials/footer') %>
