<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div><div class="eyebrow">article editor</div><h1 class="h1"><%= article ? 'Редактировать статью' : 'Новая статья' %></h1></div>
<form class="grid two align-start" method="post" action="<%= article ? `/articles/${article.id}/edit` : '/articles' %>" enctype="multipart/form-data"><div class="card stack"><div class="field"><label>Заголовок</label><input class="input" name="title" maxlength="220" value="<%= article ? article.title : '' %>" required></div><div class="field"><label>Короткий анонс</label><textarea class="textarea" name="excerpt" maxlength="700"><%= article ? (article.excerpt||'') : '' %></textarea></div><div class="field"><label>Обложка</label><input class="input" type="file" name="cover" accept="image/*"></div><div class="field"><label>Статус</label><select class="select" name="status"><option value="draft" <%= !article || article.status==='draft'?'selected':'' %>>Черновик</option><option value="published" <%= article && article.status==='published'?'selected':'' %>>Опубликовать</option></select></div><button class="pill black" type="submit">Сохранить →</button></div><div class="card blue"><div class="field"><label>Текст статьи</label><textarea class="textarea" style="min-height:620px" name="body" required placeholder="Пишите обычным текстом. Абзацы сохраняются."><%= article ? article.body : '' %></textarea><div class="hint">MVP хранит статьи как безопасный plain text. Позже сюда легко добавить полноценный редактор с заголовками, цитатами и вставками.</div></div></div></form></main>
<%- include('../partials/footer') %>
