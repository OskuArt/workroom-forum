<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section">
  <div class="row between align-start"><div><div class="eyebrow">job board</div><h1 class="h1">Вакансии</h1><p class="lead">Карточки с точной ссылкой на источник. Ищи по роли, компании, сфере, локации и формату работы.</p></div><a class="pill" href="/employers">Разместить вакансию →</a></div>
  <form class="filters jobs-filters" method="get" action="/jobs">
    <input class="input filter-query" name="q" value="<%= filters.q || '' %>" placeholder="Должность, компания, навык">
    <select class="select filter-sector custom-select" name="sector" data-placeholder="Сфера" data-theme="sector"><option value="">Сфера</option><% sectors.forEach(s=>{ %><option value="<%= s %>" <%= filters.sector===s?'selected':'' %>><%= s %></option><% }) %></select>
    <select class="select filter-mode custom-select" name="mode" data-placeholder="Формат" data-theme="mode"><option value="">Формат</option><option value="Remote" <%= filters.mode==='Remote'?'selected':'' %>>Удалённо<%= modeCounts.Remote ? ` · ${modeCounts.Remote}` : '' %></option><option value="Hybrid" <%= filters.mode==='Hybrid'?'selected':'' %>>Гибрид<%= modeCounts.Hybrid ? ` · ${modeCounts.Hybrid}` : '' %></option><option value="Office" <%= filters.mode==='Office'?'selected':'' %>>Офис<%= modeCounts.Office ? ` · ${modeCounts.Office}` : '' %></option></select>
    <select class="select filter-experience custom-select" name="experience" data-placeholder="Опыт" data-theme="experience">
      <option value="">Опыт</option>
      <option value="Без опыта" <%= filters.experience==='Без опыта'?'selected':'' %>>Без опыта</option>
      <option value="1–3 года" <%= filters.experience==='1–3 года'?'selected':'' %>>1–3 года</option>
      <option value="3–6 лет" <%= filters.experience==='3–6 лет'?'selected':'' %>>3–6 лет</option>
      <option value="6+ лет" <%= filters.experience==='6+ лет'?'selected':'' %>>6+ лет</option>
    </select>
    <input class="input filter-location" name="location" value="<%= filters.location || '' %>" placeholder="Локация">
    <label class="salary-toggle <%= filters.salary==='1'?'is-active':'' %>">
      <input type="checkbox" name="salary" value="1" <%= filters.salary==='1'?'checked':'' %>>
      <span>Только с ЗП</span>
    </label>
    <button class="pill black" type="submit">Найти</button>
  </form>
  <div class="section tight"><div class="muted"><%= jobs.length %> вакансий в текущей выборке</div></div>
  <% if(jobs.length){ %><div class="grid two"><% jobs.forEach(job=>{ %>
    <a class="card job-card hover" href="/jobs/<%= job.id %>">
      <div>
        <div class="row between"><div class="source"><%= job.featured ? '★ FEATURED · ' : '' %><%= job.source %></div><% if(job.application_status){ %><span class="status-chip status-<%= job.application_status %>"><%= applicationStatusLabels[job.application_status] %></span><% } %></div>
        <h2 class="h3"><%= job.title %></h2><strong><%= job.company %></strong><p class="summary"><%= job.summary_ru || job.summary || 'Описание доступно внутри карточки.' %></p>
        <div class="job-meta">
          <% if(job.experience){ %><span class="tag tag-experience"><%= job.experience %></span><% } %>
          <% if(job.work_mode){ %><span class="tag tag-mode"><%= job.work_mode %></span><% } %>
          <% if(job.salary){ %><span class="tag tag-salary"><%= job.salary %></span><% } %>
          <% if(job.location){ %><span class="tag tag-location"><%= job.location %></span><% } %>
          <% if(job.sector){ %><span class="tag tag-sector"><%= job.sector %></span><% } %>
          <% if(job.employment_type){ %><span class="tag tag-type"><%= job.employment_type %></span><% } %>
        </div>
      </div><span class="arrow">→</span>
    </a>
  <% }) %></div><% } else { %><div class="empty">Ничего не найдено. Попробуйте снять часть фильтров или изменить формулировку поиска.</div><% } %>
</main>
<%- include('../partials/footer') %>
