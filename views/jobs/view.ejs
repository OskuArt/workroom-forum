<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="job-detail">
  <article class="card job-full-card">
    <div class="row between">
      <div class="source"><%= job.featured ? '★ FEATURED · ' : '' %><%= job.source %></div>
      <% if(application){ %><span class="status-chip status-<%= application.status %>"><%= applicationStatusLabels[application.status] %></span><% } %>
    </div>
    <h1 class="h1"><%= job.title %></h1>
    <p class="lead"><strong><%= job.company %></strong></p>

    <div class="job-source-line">
      <% if(job.published_at){ %>
        <span><strong>Опубликовано:</strong> <%= new Date(job.published_at).toLocaleDateString('ru-RU',{day:'2-digit',month:'long',year:'numeric'}) %></span>
      <% } %>
      <% if(job.source_metadata && job.source_metadata.discovered_via==='telegram' && job.source_metadata.telegram_channel){ %>
        <span class="muted">найдено через Telegram · @<%= job.source_metadata.telegram_channel %></span>
      <% } %>
    </div>

    <% if(job.salary){ %>
      <div class="job-salary-block"><div class="eyebrow">зарплата</div><div class="job-salary"><%= job.salary %></div></div>
    <% } %>

    <div class="job-meta">
      <% if(job.experience){ %><span class="tag tag-experience"><%= job.experience %></span><% } %>
      <% if(job.work_mode){ %><span class="tag tag-mode"><%= job.work_mode %></span><% } %>
      <% if(job.location){ %><span class="tag tag-location"><%= job.location %></span><% } %>
      <% if(job.country && job.country!==job.location){ %><span class="tag tag-location"><%= job.country %></span><% } %>
      <% if(job.sector){ %><span class="tag tag-sector"><%= job.sector %></span><% } %>
      <% if(job.employment_type){ %><span class="tag tag-type"><%= job.employment_type %></span><% } %>
    </div>

    <% if(job.summary){ %><p class="lead job-summary"><%= job.summary_ru || job.summary %></p><% } %>

    <% if(job.description_ru_html){ %>
      <% if(job.source_language && job.source_language!=='ru'){ %><div class="translation-note">АВТОПЕРЕВОД · оригинал: <%= String(job.source_language).toUpperCase() %></div><% } %>
      <div class="rich"><%- job.description_ru_html %></div>
    <% } else { %>
      <div class="rich"><%- job.description_html || '<p>Подробное описание доступно на сайте-источнике.</p>' %></div>
    <% } %>

    <% const hashtags = Array.isArray(job.job_tags) ? job.job_tags.filter(Boolean) : []; %>
    <% if(hashtags.length){ %>
      <div class="job-hashtags">
        <div class="eyebrow">навыки / инструменты</div>
        <div class="hashtag-cloud"><% hashtags.forEach(tag=>{ %><span>#<%= tag %></span><% }) %></div>
      </div>
    <% } %>
  </article>
  <aside class="stack">
    <div class="card acid sticky-card stack">
      <div class="eyebrow">apply</div><h2 class="h2">Подходит?</h2>
      <p>Нажатие сохранит вакансию в «Мои отклики», а затем откроет <strong>точную страницу первоисточника</strong>.</p>
      <div class="row"><a class="pill black" href="/jobs/<%= job.id %>/apply" target="_blank" rel="noopener noreferrer">Откликнуться ↗</a><% if(user){ %><form method="post" action="/jobs/<%= job.id %>/save"><button class="pill" type="submit">Сохранить</button></form><% } %></div>
      <% if(application){ %><span class="status-chip status-<%= application.status %>"><%= applicationStatusLabels[application.status] %></span><% } %>
      <div class="smalltext muted">Источник: <%= job.source %></div>
      <% if(job.published_at){ %><div class="smalltext muted">Дата источника: <%= new Date(job.published_at).toLocaleDateString('ru-RU') %></div><% } %>
    </div>

    <% if(user){ %>
      <details class="job-share" data-job-share data-job-id="<%= job.id %>">
        <summary>↗ Переслать контакту</summary>
        <div class="job-share-body">
          <div class="smalltext muted">Выбери человека. Список листается горизонтально.</div>
          <div class="contact-strip" data-job-share-contacts>
            <div class="contact-strip-loading">Загружаю контакты…</div>
          </div>
          <div class="smalltext job-share-status" data-job-share-status></div>
        </div>
      </details>

      <details class="job-report">
        <summary>⚑ Пожаловаться на вакансию</summary>
        <form class="report-grid" method="post" action="/api/jobs/<%= job.id %>/report" enctype="multipart/form-data">
          <select class="select" name="reason_code" required>
            <option value="">Выберите причину</option>
            <option value="scam">Мошенничество</option>
            <option value="stale">Несуществующая вакансия / игнор</option>
            <option value="unfair_rejection">Отказали по необоснованным причинам</option>
            <option value="other">Другое</option>
          </select>
          <textarea class="textarea" name="comment" placeholder="Комментарий к жалобе. Для «Другое» обязателен."></textarea>
          <label class="report-evidence"><strong>Скриншоты</strong><br><span class="smalltext muted">До 4 изображений, максимум 5 МБ каждое.</span><input type="file" name="evidence" accept="image/*" multiple></label>
          <button class="pill black" type="submit">Отправить жалобу</button>
        </form>
      </details>
    <% } %>
  </aside>
</div></main>
<%- include('../partials/footer') %>
