<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><section class="card <%= group.privacy==='private'?'violet':'acid' %>"><div class="row between align-start"><div><div class="eyebrow"><%= group.privacy %> group / <%= group.members %> members</div><h1 class="h1"><%= group.name %></h1><p class="lead"><%= group.description || 'Описание пока не добавлено.' %></p><div>создал(а) <a href="/u/<%= group.username %>">@<%= group.username %></a></div></div><% if(user && !member){ %><form method="post" action="/groups/<%= group.slug %>/join"><button class="pill black" type="submit">Вступить →</button></form><% } else if(member){ %><span class="tag">Вы участник</span><% } %></div></section>
<% if(member){ %><section class="section tight"><form class="card stack" method="post" action="/groups/<%= group.slug %>/post" enctype="multipart/form-data"><div class="field"><label>Новая публикация в группе</label><textarea class="textarea" name="body" required></textarea></div><div class="row"><input class="input" type="file" name="image" accept="image/*"><button class="pill black" type="submit">Опубликовать</button></div></form></section><% } %>
<section class="section tight stack"><% if(posts.length){ posts.forEach(p=>{ %><article class="card post"><div class="post-head"><% if(p.avatar_media_id){ %><img class="avatar sm" src="/media/<%= p.avatar_media_id %>" alt=""><% } else { %><div class="avatar sm placeholder">@</div><% } %><div><a href="/u/<%= p.username %>"><strong><%= p.name || `@${p.username}` %></strong></a><div class="muted">@<%= p.username %></div></div></div><div class="post-body"><%= p.body %></div><% if(p.media_id){ %><img class="post-image" src="/media/<%= p.media_id %>" alt=""><% } %><div class="muted smalltext"><%= new Date(p.created_at).toLocaleString('ru-RU') %></div></article><% }) } else { %><div class="empty">В группе пока нет публикаций.</div><% } %></section></main>
<%- include('../partials/footer') %>
