<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="grid two align-start"><div><div class="eyebrow">communities</div><h1 class="h1">Группы по интересам</h1><p class="lead">GameDev Artists, Product Designers, iGaming, AI Creators, локальные IT-комьюнити и всё, что появится дальше.</p></div>
<% if(user){ %><form class="card yellow stack" method="post" action="/groups"><div class="field"><label>Название группы</label><input class="input" name="name" required></div><div class="field"><label>Короткий адрес</label><input class="input" name="slug" placeholder="gamedev-artists"></div><div class="field"><label>Описание</label><textarea class="textarea" name="description"></textarea></div><select class="select" name="privacy"><option value="public">Публичная</option><option value="private">Закрытая</option></select><button class="pill black" type="submit">Создать группу →</button></form><% } else { %><div class="card acid"><h2 class="h2">Создавать группы можно после регистрации.</h2><a class="pill black" href="/register">Регистрация →</a></div><% } %></div>
<section class="section tight"><div class="grid three"><% if(groups.length){ groups.forEach(g=>{ %><a class="card group-card hover <%= g.privacy==='private'?'violet':'' %>" href="/groups/<%= g.slug %>"><div><div class="eyebrow"><%= g.privacy %> / <%= g.members %> members</div><h2 class="h2"><%= g.name %></h2><p><%= g.description || 'Без описания.' %></p></div><div class="row between"><span>@<%= g.username %></span><span class="arrow <%= g.privacy==='private'?'light':'' %>">→</span></div></a><% }) } else { %><div class="empty">Групп пока нет. Создайте первую.</div><% } %></div></section></main>
<%- include('../partials/footer') %>
