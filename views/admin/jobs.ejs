<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between"><div><div class="eyebrow">admin / jobs</div><h1 class="h1">Вакансии</h1></div><form method="post" action="/admin/jobs/import"><button class="pill acid" type="submit">↻ Импорт источников</button></form></div>
<section class="grid two align-start"><form class="card black stack" method="post" action="/admin/jobs"><h2 class="h2">Добавить вручную</h2><input class="input" name="title" placeholder="Название вакансии" required><input class="input" name="company" placeholder="Компания" required><input class="input" name="source" placeholder="Источник: Direct / Telegram / X" value="Direct"><input class="input" name="source_url" type="url" placeholder="Точная ссылка на вакансию" required><textarea class="textarea" name="summary" placeholder="Красное краткое описание 3–4 строки"></textarea><textarea class="textarea" name="description" rows="10" placeholder="Полное описание"></textarea><div class="grid two"><input class="input" name="experience" placeholder="Опыт"><input class="input" name="work_mode" placeholder="Remote / Hybrid / Office"><input class="input" name="salary" placeholder="ЗП"><input class="input" name="location" placeholder="Локация"><input class="input" name="sector" placeholder="Сфера"><input class="input" name="employment_type" placeholder="Full-time"></div><input class="input" type="datetime-local" name="expires_at"><label class="checkbox"><input type="checkbox" name="featured"> Выделить вакансию</label><button class="pill acid" type="submit">Опубликовать →</button></form>
<div class="stack"><% jobs.forEach(j=>{ %><div class="card"><div class="row between"><div><div class="source"><%= j.source %></div><h3 class="h3"><%= j.title %></h3><div><%= j.company %></div></div><div class="row"><span class="tag"><%= j.featured?'FEATURED':'regular' %></span><span class="tag"><%= j.is_active?'LIVE':'OFF' %></span></div></div><div class="row"><a class="pill small" href="/jobs/<%= j.id %>" target="_blank">Открыть</a><a class="pill small" href="/admin/jobs/<%= j.id %>/edit">Редактировать</a><form method="post" action="/admin/jobs/<%= j.id %>"><input type="hidden" name="action" value="feature"><button class="pill small" type="submit">★ featured</button></form><form method="post" action="/admin/jobs/<%= j.id %>"><input type="hidden" name="action" value="active"><button class="pill small" type="submit"><%= j.is_active?'Снять':'Вернуть' %></button></form><form method="post" action="/admin/jobs/<%= j.id %>"><input type="hidden" name="action" value="delete"><button class="link-btn danger" data-confirm="Удалить вакансию безвозвратно?" type="submit">Удалить</button></form></div></div><% }) %></div></section></main>
<%- include('../partials/footer') %>
