<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div><div class="eyebrow">admin / moderation</div><h1 class="h1">Жалобы</h1></div><div class="stack"><% if(reports.length){ reports.forEach(r=>{ %><div class="card <%= r.status==='open'?'orange':'' %>"><div class="row between"><div><div class="source"><%= r.target_type %> #<%= r.target_id %></div><h3 class="h3"><%= r.reason %></h3><div class="muted">от @<%= r.reporter || 'deleted' %> · <%= new Date(r.created_at).toLocaleString('ru-RU') %></div></div><% if(r.status==='open'){ %><form method="post" action="/admin/reports/<%= r.id %>/close"><button class="pill black" type="submit">Закрыть</button></form><% } else { %><span class="tag">CLOSED</span><% } %></div></div><% }) } else { %><div class="empty">Жалоб нет.</div><% } %></div></main>
<%- include('../partials/footer') %>
