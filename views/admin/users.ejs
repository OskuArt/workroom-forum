<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div><div class="eyebrow">admin / users</div><h1 class="h1">Пользователи</h1></div><div class="card"><% users.forEach(u=>{ %><div class="admin-row"><div><strong><%= u.name || u.email %></strong><div class="muted"><%= u.username?`@${u.username}`:'без ника' %></div></div><span><%= u.role %></span><span>CV <%= u.cvs %></span><span>posts <%= u.posts %></span><span><%= u.is_banned?'BANNED':'ACTIVE' %></span><div class="row"><% if(u.username){ %><a href="/u/<%= u.username %>">↗</a><% } %><form method="post" action="/admin/users/<%= u.id %>"><input type="hidden" name="action" value="ban"><button class="link-btn" type="submit"><%= u.is_banned?'Unban':'Ban' %></button></form><form method="post" action="/admin/users/<%= u.id %>"><input type="hidden" name="action" value="admin"><button class="link-btn" type="submit"><%= u.role==='admin'?'Demote':'Admin' %></button></form></div></div><% }) %></div></main>
<%- include('../partials/footer') %>
