<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between"><div><div class="eyebrow">admin / edit job</div><h1 class="h1"><%= job.title %></h1></div><a class="pill" href="/admin/jobs">← Назад</a></div>
<form class="grid two align-start" method="post" action="/admin/jobs/<%= job.id %>/edit"><div class="card stack"><input class="input" name="title" value="<%= job.title %>" required><input class="input" name="company" value="<%= job.company %>" required><input class="input" name="source" value="<%= job.source %>"><input class="input" name="source_url" type="url" value="<%= job.source_url %>" required><textarea class="textarea" name="summary"><%= job.summary || '' %></textarea><div class="grid two"><input class="input" name="experience" value="<%= job.experience || '' %>" placeholder="Опыт"><input class="input" name="work_mode" value="<%= job.work_mode || '' %>" placeholder="Формат"><input class="input" name="salary" value="<%= job.salary || '' %>" placeholder="ЗП"><input class="input" name="location" value="<%= job.location || '' %>" placeholder="Локация"><input class="input" name="sector" value="<%= job.sector || '' %>" placeholder="Сфера"><input class="input" name="employment_type" value="<%= job.employment_type || '' %>" placeholder="Тип занятости"></div><label class="checkbox"><input type="checkbox" name="featured" <%= job.featured?'checked':'' %>> Featured</label><label class="checkbox"><input type="checkbox" name="is_active" <%= job.is_active?'checked':'' %>> Active</label><button class="pill black" type="submit">Сохранить изменения</button></div><div class="card blue stack"><div class="field"><label>Полное описание</label><textarea class="textarea" rows="28" name="description"><%= (job.description_html || '').replace(/<br\s*\/?\s*>/gi,'\n').replace(/<[^>]+>/g,'') %></textarea></div><div class="field"><label>Снять после</label><input class="input" type="datetime-local" name="expires_at" value="<%= job.expires_at ? new Date(job.expires_at).toISOString().slice(0,16) : '' %>"></div></div></form></main>
<%- include('../partials/footer') %>
