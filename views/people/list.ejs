<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between align-start"><div><div class="eyebrow">directory</div><h1 class="h1">Люди</h1><p class="lead">Найди конкретного человека по его уникальному @нику.</p></div><form class="row" method="get" action="/people"><input class="input" name="q" value="<%= term %>" placeholder="@nickname"><button class="pill black" type="submit">Поиск</button></form></div>
<% if(pending.length){ %><section class="section tight"><div class="card yellow"><div class="eyebrow">requests</div><h2 class="h2">Запросы в контакты</h2><div class="grid three"><% pending.forEach(r=>{ %><div class="card"><div class="post-head"><% if(r.avatar_media_id){ %><img class="avatar sm" src="/media/<%= r.avatar_media_id %>" alt=""><% } else { %><div class="avatar sm placeholder">@</div><% } %><div><strong><%= r.name || `@${r.username}` %></strong><div class="muted">@<%= r.username %></div></div></div><p><%= r.profession || '' %></p><div class="row"><form method="post" action="/friends/<%= r.id %>/accept"><button class="pill small acid" type="submit">Принять</button></form><a class="pill small" href="/u/<%= r.username %>">Профиль</a></div></div><% }) %></div></div></section><% } %>
<% if(contacts.length){ %><section class="section tight"><div class="row between"><div><div class="eyebrow">your network</div><h2 class="h2">Мои контакты</h2></div><span class="tag"><%= contacts.length %></span></div><div class="grid four"><% contacts.forEach(p=>{ %><div class="card"><a href="/u/<%= p.username %>"><% if(p.avatar_media_id){ %><img class="avatar" src="/media/<%= p.avatar_media_id %>" alt=""><% } else { %><div class="avatar placeholder">@</div><% } %><h3 class="h3"><%= p.name || `@${p.username}` %></h3><div>@<%= p.username %></div><p><%= p.profession || '' %></p><div class="presence-line friend-card-presence" data-presence-user="<%= p.username %>">проверяем статус…</div></a><div class="row"><a class="pill small black" href="/messages/<%= p.username %>">Написать</a><form method="post" action="/friends/<%= p.friendship_id %>/remove"><button class="link-btn danger" type="submit">Удалить</button></form></div></div><% }) %></div></section><% } %>
<% if(term){ %>
  <section class="section tight"><div class="eyebrow">search results</div><% if(people.length){ %><div class="grid four"><% people.forEach(p=>{ %><a class="card hover" href="/u/<%= p.username %>"><% if(p.avatar_media_id){ %><img class="avatar" src="/media/<%= p.avatar_media_id %>" alt=""><% } else { %><div class="avatar placeholder">@</div><% } %><div class="row"><h2 class="h3"><%= p.name || `@${p.username}` %></h2><% if(p.open_to_work){ %><span class="tag tag-sector">OPEN</span><% } %></div><div>@<%= p.username %></div><p><%= p.profession || 'Digital specialist' %></p></a><% }) %></div><% } else { %><div class="empty">Пользователь с таким @ником не найден.</div><% } %></section>
<% } else if(!pending.length && !contacts.length) { %>
  <div class="empty people-search-empty">Здесь никто не показывается автоматически. Введи @ник человека, которого хочешь найти.</div>
<% } %></main>
<%- include('../partials/footer') %>
