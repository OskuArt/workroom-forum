<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between align-start"><div><div class="eyebrow">career organizer</div><h1 class="h1">Мои отклики</h1><p class="lead">Личный карьерный CRM. Никто кроме вас этого не видит.</p></div><a class="pill" href="/my/cv">Мои CV →</a></div>
<div class="tabs status-tabs"><% const tabs=[['','Все','all'],['waiting','В ожидании','waiting'],['interview','Собеседование','interview'],['offer','Оффер','offer'],['rejected','Отказ','rejected'],['not_fit','Не подошло','not_fit']]; tabs.forEach(([k,l,c])=>{ %><a class="tab-<%= c %> <%= status===k?'active':'' %>" href="/applications<%= k?`?status=${k}`:'' %>"><%= l %></a><% }) %></div>
<div class="section tight stack"><% if(apps.length){ apps.forEach(a=>{ %><div class="card application-card"><div class="grid two"><div><div class="status-chip status-<%= a.status %>"><%= applicationStatusLabels[a.status] %></div><h2 class="h3"><%= a.title %></h2><strong><%= a.company %></strong><div class="job-meta"><% if(a.work_mode){ %><span class="tag tag-mode"><%= a.work_mode %></span><% } %><% if(a.salary){ %><span class="tag tag-salary"><%= a.salary %></span><% } %><% if(a.location){ %><span class="tag tag-location"><%= a.location %></span><% } %><% if(a.sector){ %><span class="tag tag-sector"><%= a.sector %></span><% } %></div><p><a href="<%= a.source_url %>" target="_blank" rel="noopener noreferrer"><u>Открыть источник ↗</u></a></p></div><form class="stack" method="post" action="/applications/<%= a.id %>"><select class="select status-select status-bg-<%= a.status %>" name="status"><% [['waiting','В ожидании'],['interview','Собеседование'],['offer','Оффер'],['rejected','Отказ'],['not_fit','Не подошло'],['want','Сохранено']].forEach(([k,l])=>{ %><option value="<%= k %>" <%= a.status===k?'selected':'' %>><%= l %></option><% }) %></select><textarea class="textarea" name="notes" placeholder="Личные заметки: HR, дата созвона, вилка..."><%= a.notes || '' %></textarea><button class="pill black" type="submit">Сохранить</button></form></div></div><% }) } else { %><div class="empty">Здесь пока пусто. Откройте вакансию и нажмите «Откликнуться».</div><% } %></div></main>
<%- include('../partials/footer') %>
