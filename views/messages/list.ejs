<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between align-start"><div><div class="eyebrow">messenger</div><h1 class="h1">Сообщения</h1><p class="lead">Личные диалоги внутри профессиональной сети.</p></div><a class="pill" href="/people">Найти человека →</a></div>
<div class="section tight"><% if(conversations.length){ %><div class="card"><% conversations.forEach(c=>{ %><a class="conversation" href="/messages/<%= c.username %>"><% if(c.avatar_media_id){ %><img class="avatar sm" src="/media/<%= c.avatar_media_id %>" alt=""><% } else { %><div class="avatar sm placeholder">@</div><% } %><div><strong><%= c.name || `@${c.username}` %></strong><div class="muted">@<%= c.username %> · <%= c.last_body || 'изображение' %></div></div><div class="row"><% if(c.muted){ %><span class="tag">MUTE</span><% } %><% if(c.unread){ %><span class="badge"><%= c.unread %></span><% } %></div></a><% }) %></div><% } else { %><div class="empty">Диалогов пока нет. Найдите пользователя по нику и напишите ему.</div><% } %></div></main>
<%- include('../partials/footer') %>
