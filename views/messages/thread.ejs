<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between"><div class="post-head"><% if(peer.avatar_media_id){ %><img class="avatar sm" src="/media/<%= peer.avatar_media_id %>" alt=""><% } else { %><div class="avatar sm placeholder">@</div><% } %><div><h1 class="h3"><%= peer.name || `@${peer.username}` %></h1><a class="muted" href="/u/<%= peer.username %>">@<%= peer.username %> · <%= peer.profession || '' %></a></div></div><div class="row"><form method="post" action="/messages/<%= peer.username %>/mute"><button class="pill small" type="submit"><%= muted ? 'Включить уведомления' : 'Отключить уведомления' %></button></form><form method="post" action="/messages/<%= peer.username %>/block"><button class="pill small <%= blocked ? 'acid' : '' %>" type="submit"><%= blocked ? 'Разблокировать' : 'В ЧС' %></button></form></div></div>
<div class="section tight"><div class="chat-thread" data-chat-thread data-me="<%= user.username %>" data-peer="<%= peer.username %>"><% messages.forEach(m=>{ %><div class="bubble <%= Number(m.sender_id)===Number(user.id)?'mine':'' %>" data-message-id="<%= m.id %>"><% if(m.body){ %><div><%= m.body %></div><% } %><% if(m.media_id){ %><img src="/media/<%= m.media_id %>" alt="Вложение"><% } %><div class="muted smalltext"><%= new Date(m.created_at).toLocaleTimeString('ru-RU',{hour:'2-digit',minute:'2-digit'}) %></div></div><% }) %></div>
<% if(!blocked){ %><form class="chat-compose" data-chat-form method="post" action="/messages/<%= peer.username %>/send" enctype="multipart/form-data"><input class="input" name="body" autocomplete="off" placeholder="Сообщение..."><label class="pill small">Фото<input type="file" name="image" accept="image/*" hidden></label><button class="pill black" type="submit">Отправить</button></form><% } else { %><div class="privacy-note">Диалог заблокирован. Чтобы снова писать, разблокируйте пользователя.</div><% } %></div></main>
<%- include('../partials/footer') %>
