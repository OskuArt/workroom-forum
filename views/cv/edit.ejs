<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between align-start"><div><div class="status <%= cv.status %>"><%= cv.status %></div><h1 class="h1"><%= cv.title %></h1></div><div class="view-counter">◉ <span data-cv-counter="<%= cv.id %>"><%= views %></span> уникальных просмотров</div></div>
<form class="grid two" method="post" action="/my/cv/<%= cv.id %>/edit">
  <div class="card stack"><div class="field"><label>Название CV</label><input class="input" name="title" value="<%= cv.title %>" required></div><div class="field"><label>Коротко о себе / позиционирование</label><textarea class="textarea" name="summary"><%= cv.summary || '' %></textarea></div><div class="field"><label>Опыт работы</label><textarea class="textarea" name="experience" rows="10"><%= cv.experience || '' %></textarea></div><div class="field"><label>Образование</label><textarea class="textarea" name="education"><%= cv.education || '' %></textarea></div></div>
  <div class="card blue stack"><div class="field"><label>Навыки</label><textarea class="textarea" name="skills"><%= cv.skills || '' %></textarea></div><div class="field"><label>Программы / инструменты</label><textarea class="textarea" name="programs"><%= cv.programs || '' %></textarea></div><div class="field"><label>Курсы</label><textarea class="textarea" name="courses"><%= cv.courses || '' %></textarea></div><div class="field"><label>Портфолио / ссылки</label><textarea class="textarea" name="portfolio_links"><%= cv.portfolio_links || '' %></textarea></div><button class="pill black" type="submit">Сохранить</button></div>
</form>
<div class="section tight row"><% if(cv.status!=='published'){ %><form method="post" action="/my/cv/<%= cv.id %>/status"><input type="hidden" name="status" value="published"><button class="pill acid" type="submit">Опубликовать CV →</button></form><% } else { %><a class="pill black" href="/cv/<%= cv.id %>">Открыть публичную версию</a><form method="post" action="/my/cv/<%= cv.id %>/status"><input type="hidden" name="status" value="frozen"><button class="pill" type="submit">Заморозить</button></form><% } %></div></main>
<%- include('../partials/footer') %>
