<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container section"><div class="row between align-start"><div><div class="eyebrow">career desk / CV</div><h1 class="h1">Мои CV</h1><p class="lead">Черновики, опубликованные и замороженные резюме. Каждое живёт отдельно.</p></div><form class="row" method="post" action="/my/cv/new"><input class="input tiny-input" name="title" placeholder="Название CV"><button class="pill black" type="submit">+ Новое CV</button></form></div>
<% if(cvs.length){ %><div class="grid two"><% cvs.forEach(cv=>{ %><div class="card cv-card"><div><div class="status <%= cv.status %>"><%= cv.status %></div><h2 class="h3"><%= cv.title %></h2><div class="row"><span class="tag">◉ <%= cv.views %> просмотров</span><span class="tag"><%= new Date(cv.updated_at).toLocaleDateString('ru-RU') %></span></div></div><div class="stack"><a class="pill small" href="/my/cv/<%= cv.id %>/edit">Редактировать</a><% if(cv.status==='published'){ %><a class="pill small black" href="/cv/<%= cv.id %>">Открыть</a><form method="post" action="/my/cv/<%= cv.id %>/status"><input type="hidden" name="status" value="frozen"><button class="pill small" type="submit">Заморозить</button></form><% } else { %><form method="post" action="/my/cv/<%= cv.id %>/status"><input type="hidden" name="status" value="published"><button class="pill small acid" type="submit">Опубликовать</button></form><% } %></div></div><% }) %></div><% } else { %><div class="empty">Создайте первое CV. Оно начнёт как черновик.</div><% } %></main>
<%- include('../partials/footer') %>
